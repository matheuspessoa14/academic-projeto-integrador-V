
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Perfil {
  id      Int    @id @default(autoincrement()) @db.UnsignedSmallInt
  codigo  String @unique(map: "codigo") @db.VarChar(40)
  nome    String @db.VarChar(100)

  usuarios User[]

  @@map("perfis")
}

model User {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  String  @map("tenant_id") @db.Char(36)
  nome      String  @db.VarChar(150)
  email     String  @db.VarChar(254)
  senhaHash String  @map("senha_hash") @db.VarChar(255)
  perfilId  Int     @map("perfil_id") @db.UnsignedSmallInt
  ativo     Boolean @default(true)
  
  perfil Perfil @relation(fields: [perfilId], references: [id], onUpdate: Restrict, map: "fk_usuarios_perfil")


  @@unique([tenantId, email], map: "uq_usuarios_tenant_email")
  @@index([perfilId], map: "fk_usuarios_perfil")
  @@map("usuarios")
}
