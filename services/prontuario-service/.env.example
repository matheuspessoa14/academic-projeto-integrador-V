
# Porta HTTP do Prontuario Service
PORT=3002

# Senha utilizada na inicializacao do PostgreSQL via Docker Compose
PRONTUARIO_DB_PASSWORD=SENHA

# Conexao com PostgreSQL quando o NestJS executa no Windows
DATABASE_URL="postgresql://lumera_prontuario:SENHA@127.0.0.1:55432/lumera_prontuario_dev?schema=public"
